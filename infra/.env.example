# Server-side settings for docker compose. Copy to infra/.env ON THE SERVER only.
# Never commit infra/.env.

# Public hostname of n8n; its DNS A record points at the VPS.
N8N_DOMAIN=n8n.example.com

# Generate once with: openssl rand -hex 32
# Losing it makes every stored credential unreadable. It is included in backups.
N8N_ENCRYPTION_KEY=

# Pinned images. Upgrade deliberately: back up, change, docker compose up -d.
N8N_VERSION=2.42.6
CADDY_VERSION=2.11.7-alpine

# rclone remote for backups. Use an rclone "crypt" remote: the archive holds the
# database and the encryption key together.
RCLONE_REMOTE=backup-crypt:n8n-assistant
BACKUP_KEEP_LOCAL_DAYS=7
BACKUP_KEEP_REMOTE_DAYS=30
