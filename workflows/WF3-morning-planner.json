    "Build digest": {
      "main": [
        [
          {
            "node": "Create digest page",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Create digest page": {
      "main": [
        [
          {
            "node": "One item per message",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "One item per message": {
      "main": [
        [
          {
            "node": "Send digest",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send digest": {
      "main": [
        [
          {
            "node": "FYI to close",
            "type": "main",
            "index": 0
          },
          {
            "node": "Old blocks",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "FYI to close": {
      "main": [
        [
          {
            "node": "Close FYI item",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Read today page": {
      "main": [
        [
          {
            "node": "Fetch open items",
            "type": "main",
            "index": 0
          },
          {
            "node": "Checked tasks",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Checked tasks": {
      "main": [
        [
          {
            "node": "Close checked task",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Old blocks": {
      "main": [
        [
          {
            "node": "Has old blocks?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Has old blocks?": {
      "main": [
        [
          {
            "node": "Delete block",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Write today page",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Delete block": {
      "main": [
        [
          {
            "node": "Write today page",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "timezone": "Europe/Prague"
  }
}
