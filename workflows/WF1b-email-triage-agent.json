    {
      "name": "Triage schema",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.3,
      "position": [
        1040,
        336
      ],
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"action_needed\": {\n      \"type\": \"boolean\"\n    },\n    \"action_type\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"email_reply\",\n        \"other\",\n        \"none\"\n      ]\n    },\n    \"needs_reply\": {\n      \"type\": \"boolean\"\n    },\n    \"priority\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"P1\",\n        \"P2\",\n        \"P3\",\n        \"\"\n      ]\n    },\n    \"estimate_min\": {\n      \"type\": \"integer\",\n      \"enum\": [\n        0,\n        15,\n        30,\n        60,\n        120\n      ]\n    },\n    \"fyi\": {\n      \"type\": \"boolean\"\n    },\n    \"confidence\": {\n      \"type\": \"number\"\n    },\n    \"title\": {\n      \"type\": \"string\"\n    },\n    \"summary\": {\n      \"type\": \"string\"\n    },\n    \"due\": {\n      \"type\": \"string\"\n    },\n    \"priority_reason\": {\n      \"type\": \"string\"\n    },\n    \"draft_body\": {\n      \"type\": \"string\"\n    },\n    \"draft_needs_input\": {\n      \"type\": \"boolean\"\n    }\n  },\n  \"required\": [\n    \"action_needed\",\n    \"action_type\",\n    \"needs_reply\",\n    \"priority\",\n    \"estimate_min\",\n    \"fyi\",\n    \"confidence\",\n    \"title\",\n    \"summary\",\n    \"due\",\n    \"priority_reason\",\n    \"draft_body\",\n    \"draft_needs_input\"\n  ],\n  \"additionalProperties\": false\n}"
      }
    },
