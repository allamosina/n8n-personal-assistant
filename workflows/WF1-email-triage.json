        "language": "javaScript",
        "jsCode": "const CONFIG = $('Config').first().json;\n// @inject src/claude.js as claude\n// @end-inject\nconst PROMPT = CONFIG.prompts.draft;\nconst e = $input.item.json;\nconst vars = {\n  owner_name: CONFIG.owner.name,\n  owner_context: CONFIG.owner.context,\n  owner_tone: CONFIG.owner.tone,\n  owner_signature: CONFIG.owner.signature,\n  sender: e.from,\n  subject: e.subject,\n  received: e.received,\n  body: e.body,\n};\nreturn { json: { ...e, request: claude.buildClaudeRequest(PROMPT, vars, CONFIG.models) } };\n"
