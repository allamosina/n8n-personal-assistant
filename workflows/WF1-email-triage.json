        "jsCode": "// The Gmail node outputs the draft, not the item: re-attach the item (SDK rule 7).\nconst e = $('Parse draft').item.json;\nreturn { json: { ...e, draft_created: true, draft_id: $input.item.json.id || null } };\n"
      }
