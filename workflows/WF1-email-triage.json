    {
      "name": "Parse enrich",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1880,
        300
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "language": "javaScript",
        "jsCode": "// @inject src/claude.js as claude\n// @end-inject\nconst e = $('Build enrich request').item.json;\nconst response = $input.item.json;\nconst r = claude.parseClaudeResponse(response);\nconst { request, ...rest } = e;\nreturn {\n  json: {\n    ...rest,\n    kind: e.action_type === 'email_reply' ? 'Reply' : 'Action',\n    title: r.title,\n    summary: r.summary,\n    due: r.due,\n    priority_reason: r.priority_reason,\n    sender: e.from,\n    shadow_decision: e.shadow || null,\n    usage_enrich: claude.usageOf(response),\n  },\n};\n"
      }
    },
