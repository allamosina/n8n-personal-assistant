      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "credentials": {
        "notionOAuth2Api": {
          "id": "",
          "name": "notionOAuth2Api"
        }
      }
    },
    {
      "name": "Build enrich request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1440,
        300
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "language": "javaScript",
        "jsCode": "const CONFIG = $('Config').first().json;\n// @inject src/claude.js as claude\n// @end-inject\nconst PROMPT = CONFIG.prompts.enrich;\nconst LANG = { ru: 'Russian', en: 'English', cs: 'Czech' };\nconst e = $input.item.json;\nconst vars = {\n  owner_name: CONFIG.owner.name,\n  owner_context: CONFIG.owner.context,\n  title_language: LANG[CONFIG.language.titles] || CONFIG.language.titles,\n  today: $now.setZone(CONFIG.timezone).toISODate(),\n  channel: e.channel,\n  action_type: e.action_type,\n  priority: e.priority,\n  sender: e.from,\n  subject: e.subject,\n  note: '',\n  body: e.body,\n};\nreturn { json: { ...e, request: claude.buildClaudeRequest(PROMPT, vars, CONFIG.models) } };\n"
      }
    },
    {
