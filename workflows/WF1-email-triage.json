        },
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ filter: { property: \"Source ID\", rich_text: { equals: $json.source_id } }, page_size: 1 }) }}",
        "options": {
          "timeout": 30000
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "credentials": {
        "notionOAuth2Api": {
          "id": "",
          "name": "notionOAuth2Api"
        }
      }
    },
    {
