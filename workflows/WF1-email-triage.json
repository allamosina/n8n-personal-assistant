        2780,
        200
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "language": "javaScript",
        "jsCode": "// @inject src/claude.js as claude\n// @end-inject\nconst e = $('Build draft request').item.json;\nconst response = $input.item.json;\nconst r = claude.parseClaudeResponse(response);\nconst { request, ...rest } = e;\nreturn {\n  json: {\n    ...rest,\n    draft_body: r.body,\n    draft_needs_input: r.needs_input,\n    draft_subject: /^re:/i.test(e.subject || '') ? e.subject : 'Re: ' + (e.subject || ''),\n    usage_draft: claude.usageOf(response),\n  },\n};\n"
      }
    },
